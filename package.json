{
  "name": "vero-checkout",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "deploy": "bun run build && bunx gh-pages --dist dist --nojekyll",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
